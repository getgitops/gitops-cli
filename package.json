{
  "name": "@getgitops/cli",
  "version": "1.2.0",
  "description": "CLI tool for GitOps Platform",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "gops": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "prepack": "npm run build",
    "tools:update": "tsx scripts/update-tools.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getgitops/gitops-cli.git"
  },
  "bugs": {
    "url": "https://github.com/getgitops/gitops-cli/issues"
  },
  "homepage": "https://github.com/getgitops/gitops-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
